<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:background="@color/surface"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/menu_note_edit"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/edit_note"
        app:titleTextColor="@color/on_surface"/>
    <EditText
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_muted"
        android:id="@+id/edit_title"
        android:background="@null"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_title"
        android:maxLines="2"
        android:inputType="textAutoCorrect"
        android:imeOptions="actionNext"
        android:paddingHorizontal="20dp"/>
    <View
        android:background="@color/outline"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <EditText
            android:textSize="17sp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_muted"
            android:gravity="start|top"
            android:id="@+id/edit_content"
            android:background="@null"
            android:padding="20dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_content"
            android:lineSpacingExtra="4dp"
            android:inputType="textMultiLine"/>
    </ScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/surface_variant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/on_surface_muted"
            android:id="@+id/text_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/draft_saved"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/on_surface_muted"
            android:id="@+id/text_char_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
