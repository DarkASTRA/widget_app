<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:background="@color/surface"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:elevation="1dp"
        app:title="@string/widget_config_title"
        app:titleTextColor="@color/on_surface"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Widget Live Preview"/>
            <FrameLayout
                android:background="#e2e8f0"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="180dp">
                <RelativeLayout
                    android:id="@+id/preview_widget_box"
                    android:background="@drawable/bg_widget"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:id="@+id/preview_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="• Exam on Friday at 10 AM\10• Chapter 4 &amp; 5 revision\10• हिंदी नोट्स: महत्वपूर्ण बिंदु\10• Stay focused and drink water! ��"
                        android:lineSpacingExtra="2dp"
                        android:paddingEnd="28dp"/>
                    <ImageView
                        android:id="@+id/preview_edit_icon"
                        android:background="@drawable/bg_circle_button"
                        android:padding="4dp"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_edit"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        app:tint="#ffffff"/>
                </RelativeLayout>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/select_note"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_select_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/on_surface"
                        android:id="@+id/text_selected_note_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Select a note..."
                        android:layout_weight="1"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_no_notes"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You haven&apos;t written any notes yet."/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_write_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Write text"
                    app:icon="@drawable/ic_add"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/choose_preset"/>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preset_dark"
                    style="@style/Widget.Material3.Chip.Filter"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preset_light"
                    style="@style/Widget.Material3.Chip.Filter"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_oled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preset_oled"
                    style="@style/Widget.Material3.Chip.Filter"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_warm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preset_warm"
                    style="@style/Widget.Material3.Chip.Filter"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preset_transparent"
                    style="@style/Widget.Material3.Chip.Filter"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_navy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preset_navy"
                    style="@style/Widget.Material3.Chip.Filter"/>
            </com.google.android.material.chip.ChipGroup>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/text_size"/>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_size_small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Small"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_size_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_size_large"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Large"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_size_xlarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="XL"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/text_alignment"/>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_alignment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_align_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/align_left"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_align_center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/align_center"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:textSize="15sp"
                android:textColor="@color/on_surface"
                android:id="@+id/switch_fit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fit_text_mode"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/background_opacity"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_muted"
                    android:id="@+id/text_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90%"/>
            </LinearLayout>
            <com.google.android.material.slider.Slider
                android:value="90"
                android:id="@+id/slider_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="0"
                android:valueTo="100"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_widget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/apply_widget"
            android:layout_weight="2"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
